You are given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target.

You may assume that each input would have exactly one solution, and you may not use the same element twice.

You can return the answer in any order.


// array of nums
// only one solution in each array
// can't use same element twice

// return indices of 2 elements in nums that add up to
//target
// return can be in any order

// nums = [1, 2, 3, 4, 5], target = 4 -> [0, 2]
// nums = [5, 7, 10], target = 17 -> [1, 2]
// nums = [2, 4, 5, 11], target = 16 -> [2, 3]

function addUpToTarget(nums, target){
  // first number
  for(i = 0; i < nums.length; i++){
    // second number
    for(k = 0; k < nums.length; i++){
      // compare and find the sum that equals target
      if (nums[i]+ nums[k] === target && i !== k ){
        // return indices of those 2 elements
        return [i, k]
      }
    }
  }
}

console.log(addUpToTarget([1, 2, 3, 4, 5], 4), '[0, 2]')
console.log(addUpToTarget([5, 7, 10], 17), '[1, 2]')
console.log(addUpToTarget([2, 4, 5, 11], 16), '[2, 3]')
