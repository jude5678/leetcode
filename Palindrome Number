Given an integer x, return true if x is a palindrome, and false otherwise.


// given an integer (x)
// x is a whole number, positive

// palindrome reads the same forward and backward
// return true if x is a palindrome, false if not

// 808 -> true
// 952 -> false
// 11 -> true

function palindrome(x){
  let array = []
  array.unshift(x)

  let convertedToString = array.toString()
  
  // reverse string
  let reversed = convertedToString.split('').reverse().join('')

  // compare the reverse to the original
  if(reversed == x){
    // if they are the same, return true
    return true
  }else{
    return false
  }
}

console.log(palindrome(808), 'true')
console.log(palindrome(952), 'false')
console.log(palindrome(11), 'true')
